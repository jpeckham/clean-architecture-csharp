{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Media": {
    "Provider": "FileSystem"
  },
  "LocalMedia": {
    "RootPath": "App_Data/media"
  },
  "AzureBlobMedia": {
    "ProfileImagesContainer": "profile-images",
    "PostMediaContainer": "post-media"
  }
}
