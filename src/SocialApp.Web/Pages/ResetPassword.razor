@page "/reset-password"
@inject SocialApp.Web.Services.SocialAppApiClient Api
@inject NavigationManager Navigation

<PageTitle>Reset password - SocialApp</PageTitle>

<section class="auth">
    <div class="auth-panel">
        <h1>Reset Password</h1>
        <p>Create a new password using your one-time link.</p>

        <EditForm Model="@form" OnValidSubmit="ResetAsync">
            <InputText type="password" @bind-Value="form.NewPassword" placeholder="New password" />
            <button type="submit" disabled="@isBusy">Change Password</button>
        </EditForm>

        @if (!string.IsNullOrWhiteSpace(message))
        {
            <p class="message">@message</p>
        }
    </div>
</section>

@code {
    [SupplyParameterFromQuery]
    public string Token { get; set; } = string.Empty;

    private readonly ResetForm form = new();
    private string? message;
    private bool isBusy;

    private async Task ResetAsync()
    {
        isBusy = true;
        try
        {
            var result = await Api.ResetPasswordAsync(new(Token, form.NewPassword));
            if (result?.Succeeded == true)
            {
                Navigation.NavigateTo("/");
                return;
            }

            message = result?.Message ?? "Password reset failed.";
        }
        finally
        {
            isBusy = false;
        }
    }

    private sealed class ResetForm
    {
        public string NewPassword { get; set; } = string.Empty;
    }
}
