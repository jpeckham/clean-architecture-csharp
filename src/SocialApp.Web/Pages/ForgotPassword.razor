@page "/forgot-password"
@inject SocialApp.Web.Services.SocialAppApiClient Api

<PageTitle>Forgot password - SocialApp</PageTitle>

<section class="auth">
    <div class="auth-panel">
        <h1>Forgot Password</h1>
        <p>Enter your email and we will send a one-time reset link.</p>

        <EditForm Model="@form" OnValidSubmit="RequestAsync">
            <InputText @bind-Value="form.Email" placeholder="email@example.com" />
            <button type="submit" disabled="@isBusy">Send Reset Link</button>
        </EditForm>

        <p class="switch"><a href="/">Back to login</a></p>

        @if (!string.IsNullOrWhiteSpace(message))
        {
            <p class="message">@message</p>
        }
    </div>
</section>

@code {
    private readonly ResetRequestForm form = new();
    private string? message;
    private bool isBusy;

    private async Task RequestAsync()
    {
        isBusy = true;
        try
        {
            var result = await Api.RequestPasswordResetAsync(new(form.Email));
            message = result?.Message ?? "If the account exists, a reset link was sent.";
        }
        finally
        {
            isBusy = false;
        }
    }

    private sealed class ResetRequestForm
    {
        public string Email { get; set; } = string.Empty;
    }
}
