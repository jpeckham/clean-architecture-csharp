@page "/feed"
@page "/feed/search"
@using System.Globalization
@inject SocialApp.Web.Services.SocialAppApiClient Api
@inject SocialApp.Web.Services.AppSession Session
@inject NavigationManager Navigation
@inject IJSRuntime Js

<PageTitle>Feed - SocialApp</PageTitle>

<section class="workspace">
    <header class="masthead">
        <div>
            <h1>Recent Posts</h1>
            <p>Signed in as @Session.Handle</p>
        </div>
        <div class="actions">
            <button type="button" class="secondary" @onclick="RefreshCurrentPostsAsync" disabled="@isBusy">Refresh</button>
            <button type="button" class="secondary" @onclick="SignOut">Log Out</button>
        </div>
    </header>

    <div class="feed-layout">
        <section class="panel composer">
            <div class="composer-header">
                <div>
                    <h2>Create Post</h2>
                    <p>Post as @Session.Handle</p>
                </div>
            </div>
            <EditForm Model="@post" OnValidSubmit="CreatePostAsync">
                <InputTextArea @bind-Value="post.Content" class="composer-input" placeholder="Share an update with your network." />
                <div class="composer-media">
                    <label class="file-button secondary-file">
                        <InputFile OnChange="SelectMediaAsync" accept="image/*,video/*" multiple disabled="@(isBusy || isUploadingMedia)" />
                        <span>@(isUploadingMedia ? "Uploading media..." : "Add media")</span>
                    </label>
                    @if (selectedMedia.Count > 0)
                    {
                        <button type="button" class="secondary compact" @onclick="ClearSelectedMedia" disabled="@(isBusy || isUploadingMedia)">Clear</button>
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(mediaMessage))
                {
                    <p class="field-message">@mediaMessage</p>
                }
                @if (selectedMedia.Count > 0)
                {
                    <div class="media-preview-grid">
                        @foreach (var media in selectedMedia)
                        {
                            <figure class="media-preview">
                                @if (media.IsVideo)
                                {
                                    <video src="@media.PreviewUrl" controls preload="metadata"></video>
                                }
                                else
                                {
                                    <img src="@media.PreviewUrl" alt="" />
                                }
                                <figcaption>@media.Status</figcaption>
                            </figure>
                        }
                    </div>
                }
                <div class="composer-submit-row">
                    <span>@(selectedMedia.Count == 0 ? "Text only" : $"{selectedMedia.Count} media selected")</span>
                    <button type="submit" disabled="@IsPostSubmitDisabled">Post</button>
                </div>
            </EditForm>
        </section>

        <section class="feed">
            <div class="feed-title-row">
                <h2>@(IsSearching ? "Search Results" : "Recent")</h2>
                @if (IsSearching)
                {
                    <button type="button" class="secondary compact" @onclick="ClearSearchAsync" disabled="@isBusy">Clear</button>
                }
            </div>
            <EditForm Model="@search" OnValidSubmit="SearchPostsAsync" class="search-form">
                <InputText @bind-Value="search.Query" placeholder="Search posts by content" />
                <button type="submit" class="compact" disabled="@isBusy">Search</button>
            </EditForm>
            @if (posts.Count == 0)
            {
                <p class="empty">@(IsSearching ? "No posts matched your search." : "No posts yet.")</p>
            }
            else
            {
                @foreach (var item in posts)
                {
                    <PostCard
                        Item="item"
                        CurrentHandle="@Session.Handle"
                        IsBusy="@isBusy"
                        ShowConversationPreview="false"
                        ActiveRepostPostId="@activeRepostPostId"
                        RepostContent="@repostContent"
                        RepostContentChanged="value => repostContent = value"
                        ActiveReplyPostId="@activeReplyPostId"
                        ReplyContent="@replyContent"
                        ReplyContentChanged="value => replyContent = value"
                        OpenRequested="OpenPost"
                        ShareRequested="SharePostAsync"
                        DeleteRequested="DeletePostAsync"
                        LikeToggled="ToggleLikeAsync"
                        ReplyToggled="ToggleReplyComposerAsync"
                        ReplySubmitted="ReplyAsync"
                        ReplyCanceled="CancelReply"
                        RepostToggled="ToggleRepostComposerAsync"
                        RepostSubmitted="RepostAsync"
                        RepostCanceled="CancelRepost" />
                }
            }
        </section>
    </div>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <p class="message">@message</p>
    }
</section>

@code {
    private readonly PostForm post = new();
    private readonly SearchForm search = new();
    private readonly List<SocialApp.Web.Services.PostSummaryResult> posts = new();
    private readonly List<SelectedMedia> selectedMedia = new();
    private string? message;
    private string? mediaMessage;
    private Guid? activeRepostPostId;
    private string repostContent = string.Empty;
    private Guid? activeReplyPostId;
    private string replyContent = string.Empty;
    private bool isBusy;
    private bool isUploadingMedia;

    private const long MaxPostMediaBytes = 50 * 1024 * 1024;

    [SupplyParameterFromQuery(Name = "query")]
    public string? Query { get; set; }

    private bool IsSearching => !string.IsNullOrWhiteSpace(search.Query);
    private bool IsPostSubmitDisabled =>
        isBusy ||
        isUploadingMedia ||
        selectedMedia.Any(media => media.AssetId is null || media.Failed) ||
        string.IsNullOrWhiteSpace(post.Content) && selectedMedia.Count == 0;

    protected override async Task OnParametersSetAsync()
    {
        if (!Session.IsLoggedIn)
        {
            Navigation.NavigateTo("/");
            return;
        }

        search.Query = Query ?? string.Empty;

        if (IsSearching)
        {
            await SearchCurrentQueryAsync();
            return;
        }

        await LoadPostsAsync();
    }

    private async Task CreatePostAsync()
    {
        if (!Session.IsLoggedIn)
        {
            Navigation.NavigateTo("/");
            return;
        }

        await RunAsync(async () =>
        {
            var mediaAssetIds = selectedMedia
                .Select(media => media.AssetId)
                .Where(assetId => assetId.HasValue)
                .Select(assetId => assetId!.Value)
                .ToArray();
            var result = await Api.CreatePostAsync(Session.SessionToken!, new(post.Content, mediaAssetIds));
            message = result?.Message ?? "Post failed.";
            if (result?.Succeeded == true)
            {
                post.Content = string.Empty;
                ClearSelectedMedia();
                await RefreshCurrentPostsAsync();
            }
        });
    }

    private async Task SelectMediaAsync(InputFileChangeEventArgs args)
    {
        if (!Session.IsLoggedIn)
        {
            Navigation.NavigateTo("/");
            return;
        }

        mediaMessage = null;
        selectedMedia.Clear();
        var files = args.GetMultipleFiles(10).ToArray();
        var validation = ValidateMediaSelection(files);
        if (validation is not null)
        {
            mediaMessage = validation;
            return;
        }

        isUploadingMedia = true;
        try
        {
            foreach (var file in files)
            {
                var media = new SelectedMedia(file.Name, file.ContentType, file.Size, IsVideo(file), await CreatePreviewUrlAsync(file), "Preparing...");
                selectedMedia.Add(media);
                await UploadMediaAsync(file, media);
            }
        }
        finally
        {
            isUploadingMedia = false;
        }
    }

    private async Task UploadMediaAsync(IBrowserFile file, SelectedMedia media)
    {
        try
        {
            media.Status = "Reserving upload...";
            var kind = media.IsVideo ? "Video" : "Image";
            var begin = await Api.BeginPostMediaUploadAsync(
                Session.SessionToken!,
                new(kind, file.ContentType, file.Size, AltText: file.Name));
            if (begin is not { Succeeded: true, AssetId: not null, UploadUrl: not null })
            {
                media.Fail(begin?.Message ?? "Media upload was rejected.");
                return;
            }

            media.Status = "Uploading...";
            var store = await Api.StoreUploadAsync(begin.UploadUrl, file, MaxPostMediaBytes);
            if (store is not { Succeeded: true })
            {
                media.Fail(store?.Message ?? "Media upload failed.");
                return;
            }

            media.Status = "Completing...";
            var complete = await Api.CompletePostMediaUploadAsync(Session.SessionToken!, begin.AssetId.Value);
            if (complete is not { Succeeded: true, AssetId: not null })
            {
                media.Fail(complete?.Message ?? "Media upload could not be completed.");
                return;
            }

            media.AssetId = complete.AssetId.Value;
            media.Status = "Ready";
        }
        catch (Exception ex) when (ex is HttpRequestException or IOException or InvalidOperationException)
        {
            media.Fail(ex.Message);
        }
    }

    private static string? ValidateMediaSelection(IReadOnlyList<IBrowserFile> files)
    {
        if (files.Count == 0)
        {
            return null;
        }

        var imageCount = files.Count(file => file.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase));
        var videoCount = files.Count(file => file.ContentType.StartsWith("video/", StringComparison.OrdinalIgnoreCase));
        if (imageCount + videoCount != files.Count)
        {
            return "Only image and video files can be attached.";
        }

        if (files.Any(file => file.Size <= 0 || file.Size > MaxPostMediaBytes))
        {
            return "Each media file must be larger than 0 bytes and no more than 50 MB.";
        }

        if (videoCount > 0 && imageCount > 0)
        {
            return "Choose either up to 4 images or 1 video.";
        }

        if (imageCount > 4)
        {
            return "Choose up to 4 images.";
        }

        if (videoCount > 1)
        {
            return "Choose only 1 video.";
        }

        return null;
    }

    private static async Task<string> CreatePreviewUrlAsync(IBrowserFile file)
    {
        await using var stream = file.OpenReadStream(MaxPostMediaBytes);
        using var buffer = new MemoryStream();
        await stream.CopyToAsync(buffer);
        var contentType = string.IsNullOrWhiteSpace(file.ContentType) ? "application/octet-stream" : file.ContentType;
        return $"data:{contentType};base64,{Convert.ToBase64String(buffer.ToArray())}";
    }

    private static bool IsVideo(IBrowserFile file) =>
        file.ContentType.StartsWith("video/", StringComparison.OrdinalIgnoreCase);

    private void ClearSelectedMedia()
    {
        selectedMedia.Clear();
        mediaMessage = null;
    }

    private async Task DeletePostAsync(SocialApp.Web.Services.PostSummaryResult item)
    {
        if (!Session.IsLoggedIn)
        {
            Navigation.NavigateTo("/");
            return;
        }

        var confirmed = await Js.InvokeAsync<bool>("confirm", "Delete this post?");
        if (!confirmed)
        {
            return;
        }

        await RunAsync(async () =>
        {
            var result = await Api.DeletePostAsync(Session.SessionToken!, item.Id);
            message = result?.Message ?? "Delete failed.";
            await RefreshCurrentPostsAsync();
        });
    }

    private async Task ToggleLikeAsync(SocialApp.Web.Services.PostSummaryResult item)
    {
        if (!Session.IsLoggedIn)
        {
            Navigation.NavigateTo("/");
            return;
        }

        await RunAsync(async () =>
        {
            var result = item.LikedByCurrentReader
                ? await Api.DeleteLikeAsync(Session.SessionToken!, item.Id)
                : await Api.LikePostAsync(Session.SessionToken!, item.Id);
            message = result?.Message ?? "Like update failed.";
            await RefreshCurrentPostsAsync();
        });
    }

    private async Task ToggleRepostComposerAsync(SocialApp.Web.Services.PostSummaryResult item)
    {
        if (!Session.IsLoggedIn)
        {
            Navigation.NavigateTo("/");
            return;
        }

        if (item.RepostedByCurrentReader)
        {
            var confirmed = await Js.InvokeAsync<bool>("confirm", "Delete your repost of this post?");
            if (!confirmed)
            {
                return;
            }

            await RunAsync(async () =>
            {
                var result = await Api.DeleteMyRepostAsync(Session.SessionToken!, item.Id);
                message = result?.Message ?? "Delete repost failed.";
                await RefreshCurrentPostsAsync();
            });
            return;
        }

        activeRepostPostId = activeRepostPostId == item.Id ? null : item.Id;
        repostContent = string.Empty;
        activeReplyPostId = null;
        replyContent = string.Empty;
    }

    private void ToggleReplyComposerAsync(SocialApp.Web.Services.PostSummaryResult item)
    {
        activeReplyPostId = activeReplyPostId == item.Id ? null : item.Id;
        replyContent = string.Empty;
        activeRepostPostId = null;
        repostContent = string.Empty;
    }

    private async Task ReplyAsync(SocialApp.Web.Services.PostSummaryResult item)
    {
        if (!Session.IsLoggedIn)
        {
            Navigation.NavigateTo("/");
            return;
        }

        await RunAsync(async () =>
        {
            var result = await Api.ReplyToPostAsync(Session.SessionToken!, item.Id, new(replyContent));
            message = result?.Message ?? "Reply failed.";
            activeReplyPostId = null;
            replyContent = string.Empty;
            await RefreshCurrentPostsAsync();
        });
    }

    private void CancelReply()
    {
        activeReplyPostId = null;
        replyContent = string.Empty;
    }

    private async Task RepostAsync(SocialApp.Web.Services.PostSummaryResult item)
    {
        if (!Session.IsLoggedIn)
        {
            Navigation.NavigateTo("/");
            return;
        }

        await RunAsync(async () =>
        {
            var result = await Api.RepostAsync(Session.SessionToken!, item.Id, new(repostContent));
            message = result?.Message ?? "Repost failed.";
            activeRepostPostId = null;
            repostContent = string.Empty;
            await RefreshCurrentPostsAsync();
        });
    }

    private void CancelRepost()
    {
        activeRepostPostId = null;
        repostContent = string.Empty;
    }

    private void OpenPost(SocialApp.Web.Services.PostSummaryResult item)
    {
        Navigation.NavigateTo(PostUrl(item.Id));
    }

    private async Task SharePostAsync(SocialApp.Web.Services.PostSummaryResult item)
    {
        var url = Navigation.ToAbsoluteUri(PostUrl(item.Id)).ToString();
        await Js.InvokeVoidAsync("prompt", "Share this post", url);
    }

    private async Task LoadPostsAsync()
    {
        if (!Session.IsLoggedIn)
        {
            return;
        }

        var result = await Api.GetRecentPostsAsync(Session.SessionToken!);
        posts.Clear();
        posts.AddRange(result?.Posts ?? Array.Empty<SocialApp.Web.Services.PostSummaryResult>());
    }

    private async Task SearchPostsAsync()
    {
        if (!Session.IsLoggedIn)
        {
            Navigation.NavigateTo("/");
            return;
        }

        if (string.IsNullOrWhiteSpace(search.Query))
        {
            Navigation.NavigateTo("/feed");
            return;
        }

        Navigation.NavigateTo($"/feed/search?query={Uri.EscapeDataString(search.Query.Trim())}");
    }

    private void ClearSearchAsync()
    {
        Navigation.NavigateTo("/feed");
    }

    private async Task RefreshCurrentPostsAsync()
    {
        if (IsSearching)
        {
            await SearchCurrentQueryAsync();
            return;
        }

        await LoadPostsAsync();
    }

    private async Task SearchCurrentQueryAsync()
    {
        var result = await Api.SearchPostsAsync(Session.SessionToken!, search.Query);
        posts.Clear();
        posts.AddRange(result?.Posts ?? Array.Empty<SocialApp.Web.Services.PostSummaryResult>());
    }

    private async Task RunAsync(Func<Task> action)
    {
        isBusy = true;
        message = null;
        try
        {
            await action();
        }
        catch (HttpRequestException ex)
        {
            message = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private bool CanDelete(SocialApp.Web.Services.PostSummaryResult item) =>
        string.Equals(item.AuthorHandle, Session.Handle, StringComparison.OrdinalIgnoreCase);

    private static string UserUrl(string handle) => $"/users/{Uri.EscapeDataString(handle)}";

    private static string PostUrl(Guid postId) => $"/posts/{postId}";

    private static string FormatTimestamp(DateTimeOffset createdAt)
    {
        var local = createdAt.ToLocalTime();
        var culture = CultureInfo.CurrentCulture;
        if (!culture.Name.StartsWith("en", StringComparison.OrdinalIgnoreCase))
        {
            return local.ToString("f", culture);
        }

        return $"{local.ToString("MMMM", culture)} {local.Day}{OrdinalSuffix(local.Day)}, {local.ToString("yyyy h:mm tt", culture)}";
    }

    private static string OrdinalSuffix(int day)
    {
        if (day is 11 or 12 or 13)
        {
            return "th";
        }

        return (day % 10) switch
        {
            1 => "st",
            2 => "nd",
            3 => "rd",
            _ => "th"
        };
    }

    private bool IsOwnRepostTarget(SocialApp.Web.Services.PostSummaryResult item)
    {
        var targetAuthor = item.QuotedPost?.AuthorHandle ?? item.AuthorHandle;
        return string.Equals(targetAuthor, Session.Handle, StringComparison.OrdinalIgnoreCase);
    }

    private void SignOut()
    {
        Session.SignOut();
        Navigation.NavigateTo("/");
    }

    private sealed class PostForm
    {
        public string Content { get; set; } = string.Empty;
    }

    private sealed class SearchForm
    {
        public string Query { get; set; } = string.Empty;
    }

    private sealed class SelectedMedia(string fileName, string contentType, long byteLength, bool isVideo, string previewUrl, string status)
    {
        public string FileName { get; } = fileName;
        public string ContentType { get; } = contentType;
        public long ByteLength { get; } = byteLength;
        public bool IsVideo { get; } = isVideo;
        public string PreviewUrl { get; } = previewUrl;
        public string Status { get; set; } = status;
        public Guid? AssetId { get; set; }
        public bool Failed { get; private set; }

        public void Fail(string message)
        {
            Failed = true;
            Status = message;
        }
    }
}
