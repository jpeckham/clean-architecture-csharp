@inject SocialApp.Web.Services.SocialAppApiClient Api
@inject SocialApp.Web.Services.AppSession Session
@inject NavigationManager Navigation

@if (Session.IsLoggedIn)
{
    <div class="account-menu">
        <button type="button"
                class="account-menu-button"
                aria-label="Open profile menu"
                aria-haspopup="menu"
                aria-expanded="@isMenuOpen"
                @onclick="ToggleMenu">
            <span class="account-thumbnail">
                @if (profile?.ProfileImage is not null)
                {
                    <img src="@Api.ToAbsoluteApiUrl(profile.ProfileImage.ImageUrl)" alt="" />
                }
                else
                {
                    <span>@Initials(profile?.DisplayName, Session.Handle)</span>
                }
            </span>
        </button>
        @if (isMenuOpen)
        {
            <div class="account-menu-popover" role="menu">
                <button type="button" class="account-menu-item" role="menuitem" @onclick="OpenProfile">Profile</button>
                <button type="button" class="account-menu-item" role="menuitem" @onclick="LogOut">Log Out</button>
            </div>
        }
    </div>
}

@code {
    private SocialApp.Web.Services.UserProfileResult? profile;
    private string? loadedHandle;
    private bool isMenuOpen;

    protected override async Task OnParametersSetAsync()
    {
        await Session.RestoreAsync();

        if (!Session.IsLoggedIn)
        {
            profile = null;
            loadedHandle = null;
            isMenuOpen = false;
            return;
        }

        if (string.Equals(loadedHandle, Session.Handle, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        loadedHandle = Session.Handle;
        profile = await Api.GetUserAsync(Session.SessionToken!, Session.Handle!);
    }

    private void ToggleMenu() => isMenuOpen = !isMenuOpen;

    private void OpenProfile()
    {
        isMenuOpen = false;
        Navigation.NavigateTo($"/users/{Uri.EscapeDataString(Session.Handle!)}");
    }

    private async Task LogOut()
    {
        isMenuOpen = false;
        await Session.SignOutAsync();
        Navigation.NavigateTo("/");
    }

    private static string Initials(string? displayName, string? handle)
    {
        var source = string.IsNullOrWhiteSpace(displayName) ? handle?.TrimStart('@') : displayName;
        if (string.IsNullOrWhiteSpace(source))
        {
            return "?";
        }

        var parts = source.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        return string.Concat(parts.Take(2).Select(part => char.ToUpperInvariant(part[0])));
    }
}
