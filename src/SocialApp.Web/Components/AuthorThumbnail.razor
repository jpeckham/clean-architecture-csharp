@inject SocialApp.Web.Services.SocialAppApiClient Api

<span class="author-thumbnail" aria-hidden="true">
    @if (!string.IsNullOrWhiteSpace(ImageUrl))
    {
        <img src="@Api.ToAbsoluteApiUrl(ImageUrl)" alt="" />
    }
    else
    {
        @Initial
    }
</span>

@code {
    [Parameter]
    public string? ImageUrl { get; set; }

    [Parameter, EditorRequired]
    public string AuthorHandle { get; set; } = string.Empty;

    private string Initial =>
        string.IsNullOrWhiteSpace(AuthorHandle)
            ? "?"
            : AuthorHandle.Trim().TrimStart('@')[..1].ToUpperInvariant();
}
