        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-api-{0}', variables('suffix')))]",
        "[resourceId('Microsoft.KeyVault/vaults/accessPolicies', parameters('keyVaultName'), 'add')]",
        "[resourceId('Microsoft.App/managedEnvironments', format('cae-{0}', variables('suffix')))]",
        "[resourceId('Microsoft.KeyVault/vaults/secrets', parameters('keyVaultName'), format('cleansocial-{0}-cosmos-mongo-connection-string', parameters('environmentName')))]",
        "[resourceId('Microsoft.KeyVault/vaults/secrets', parameters('keyVaultName'), format('cleansocial-{0}-password-reset-base-url', parameters('environmentName')))]",
        "[resourceId('Microsoft.Storage/storageAccounts/blobServices/containers', format('st{0}media', variables('compactSuffix')), 'default', 'post-images')]",
        "[resourceId('Microsoft.Storage/storageAccounts/blobServices/containers', format('st{0}media', variables('compactSuffix')), 'default', 'profile-images')]",
        "[resourceId('Microsoft.Storage/storageAccounts', format('st{0}media', variables('compactSuffix')))]"
      ]
    }
  ],
