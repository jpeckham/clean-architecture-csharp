        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-github-{0}', variables('suffix')))]"
      ]
    },
    {
      "condition": "[parameters('manageRoleAssignments')]",
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
