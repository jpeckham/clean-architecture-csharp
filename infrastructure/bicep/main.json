                {
                  "type": "Readiness",
                  "httpGet": {
                    "path": "/health",
                    "port": "[parameters('apiContainerPort')]"
                  },
                  "initialDelaySeconds": 10,
                  "periodSeconds": 15
                }
              ]
            }
          ]
        }
      },
